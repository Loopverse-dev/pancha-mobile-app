{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@/components": ["./components"],
      "@/constants": ["./constants"],
      "@/types": ["./types"],
      "@/utils": ["./utils"],
      "@/hooks": ["./hooks"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
